# API モード: mock（開発時の既定）または real（本番）
# mock: MSW でモックし、ultradonguri-server と OBS には接続しない
# real: シーン切替を ultradonguri-server に送り、ミュートのために OBS に接続する
VITE_API_MODE=mock

# ultradonguri-server の URL（real モードで使う。例: http://localhost:8080）
VITE_API_BASE_URL=

# OBS WebSocket の接続先。ブラウザから見たアドレスを書く（未設定の場合は ws://localhost:4455）
# VITE_* と違い、ビルド時ではなく controller の起動時に読む
OBS_WEBSOCKET_URL=
# OBS WebSocket のパスワード（OBS の「ツール → WebSocket サーバー設定」で設定したもの）
OBS_WEBSOCKET_PASSWORD=
