# API mode: "mock" (development default) or "real" (production)
# GET /performances（楽曲データ取得）のみに影響する。
# Controller <-> Viewer のリアルタイム通信は Vite サーバー内の WebSocket リレーで行う。
VITE_API_MODE=mock

# HTTP API Base URL (mockモードでは空。相対パスを使う。realモードは必須：http://localhost:8080 等)
VITE_API_BASE_URL=

# osechiAPI Base URL（mockモードでは空。相対パスを使う。realモードは必須：http://localhost:7878 等）
VITE_OSECHI_BASE_URL=