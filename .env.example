# API モード: mock（開発時の既定）または real（本番）
# mock: OBS に接続しない（ミュートは画面の表示だけが切り替わり、シーンは切り替えない）
# real: OBS に接続し、ミュートとシーン切替を行う
VITE_API_MODE=mock

# OBS WebSocket の接続先。ブラウザから見たアドレスを書く（未設定の場合は ws://localhost:4455）
# VITE_* と違い、ビルド時ではなく controller の起動時に読む
OBS_WEBSOCKET_URL=
# OBS WebSocket のパスワード（OBS の「ツール → WebSocket サーバー設定」で設定したもの）
OBS_WEBSOCKET_PASSWORD=
# 番組シーンにするシーンの名前（未設定の場合は Normal_Scene / CM_Scene / Burari_Scene）
OBS_NORMAL_SCENE_NAME=
OBS_CM_SCENE_NAME=
OBS_BURARI_SCENE_NAME=
